{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"verify-phase0": "bun run scripts/verify-phase0-env.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1038.0",
		"@klyp/api": "workspace:*",
		"@klyp/auth": "workspace:*",
		"@klyp/db": "workspace:*",
		"@klyp/env": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"@remotion/media-utils": "^4.0.454",
		"@remotion/renderer": "^4.0.454",
		"better-auth": "catalog:",
		"cors": "^2.8.5",
		"dotenv": "catalog:",
		"express": "^5.1.0",
		"inngest": "^4.2.5",
		"remotion": "^4.0.454",
		"zod": "catalog:"
	},
	"devDependencies": {
		"inngest-cli": "latest",
		"@klyp/config": "workspace:*",
		"@remotion/bundler": "^4.0.454",
		"@types/bun": "catalog:",
		"@types/cors": "^2.8.17",
		"@types/express": "catalog:",
		"tsdown": "^0.16.5",
		"typescript": "^5"
	}
}
